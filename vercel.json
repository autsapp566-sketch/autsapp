{
  "version": 2,
  "installCommand": "npm install && npm run vercel-build",
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": [
        "node_modules/.prisma/**",
        "node_modules/@prisma/client/**",
        "prisma/schema.prisma"
      ]
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}