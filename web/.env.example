# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Express API (server-to-server only — never exposed to the browser). Same service as ../src.
API_URL=http://localhost:3000

# Public URL of this site (used for absolute links / metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Dev only: proxy /dashboard to the Vite server (`npm run dev` in ../client).
# On Vercel leave this UNSET. The dashboard is built into this app and served at /dashboard.
# Set it only to host the SPA on a different origin.
DASHBOARD_ORIGIN=http://localhost:5173

# On the API server (../.env) set WEB_PUBLIC_URL to this site's URL and SMTP_URL for real e-mails.
