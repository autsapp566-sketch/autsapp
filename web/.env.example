# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Express API (server-to-server only — never exposed to the browser). Same service as ../src.
API_URL=http://localhost:3000

# Public URL of this site (used for absolute links / metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Where the Vite dashboard (../client) is served. /dashboard/* is reverse-proxied there AFTER the
# auth middleware has accepted the session. Leave empty to disable the proxy.
#   dev:  http://localhost:5173   (start the SPA with VITE_ASSET_BASE=http://localhost:5173/)
#   prod: https://your-dashboard.vercel.app   (build the SPA with VITE_ASSET_BASE=<same URL>/)
DASHBOARD_ORIGIN=http://localhost:5173

# On the API server (../.env) set WEB_PUBLIC_URL to this site's URL and SMTP_URL for real e-mails.
