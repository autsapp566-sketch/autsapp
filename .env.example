# Vercel API project: DATABASE_URL, DIRECT_URL, JWT_SECRET.
# CORS_ORIGIN = client URL(s), e.g. https://client-smoky-zeta.vercel.app,http://localhost:5173
# Build runs `prisma generate` — DIRECT_URL must exist at build time (same as Supabase session/direct URI).

# Bootstrap du serveur uniquement (le reste se configure dans le dashboard)
NODE_ENV=development
PORT=3000
# Runtime (Vercel/serverless): Transaction pooler — port 6543 + pgbouncer
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Required for `prisma db push` / migrate — Direct OR Session pooler on 5432 (NOT 6543)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Login accounts created/updated by `npm run db:seed` (not shown anywhere in the UI).
# Quote the password if it contains # or spaces. Minimum 8 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AGENT_EMAIL=
AGENT_PASSWORD=

# Multi-tenant SaaS
# Platform operators (comma-separated emails): the only ADMINs allowed to edit the still-global settings
# (shared OpenAI key / bot prompt, Green API, Evolution diagnostics). Defaults to ADMIN_EMAIL.
# PLATFORM_ADMIN_EMAILS=owner@example.com
# Hours an ACTIVE subscription keeps working after currentPeriodEnd while waiting for the renewal webhook.
# BILLING_PERIOD_GRACE_HOURS=72
# Optional checkout price ids stored on the plans by `npm run db:seed` (STRIPE_PRICE_<TIER> / PADDLE_PRICE_<TIER>).
# Self-service signup + e-mail flows (the Next.js site in ./web talks to this API server-to-server).
# Public URL of the Next.js site — used in verification / password-reset links.
# WEB_PUBLIC_URL=http://localhost:3001
# SMTP connection string, e.g. smtps://user:pass@smtp.example.com. Empty = links are only logged (dev).
# SMTP_URL=
# MAIL_FROM="Autsapp <no-reply@yourdomain.com>"
# Free trial length (Starter limits) granted at signup. 0 = no free access until a subscription is attached.
# TRIAL_DAYS=14

# --- Super admin panel (/admin) ---
# The seeded ADMIN_EMAIL user becomes SUPER_ADMIN. Promote anyone else from the CLI only:
#   npm run admin:grant -- someone@example.com     (npm run admin:revoke -- ... to undo)
# Optional: Redis used by your Evolution API container, shown in the health monitor.
# REDIS_URL=redis://:password@localhost:6379

# --- Stripe (Checkout + Billing Portal) ---
# Secret key (sk_test_… / sk_live_…) — Dashboard → Developers → API keys.
# STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…). Point the endpoint at  <WEB or API origin>/api/stripe/webhook
# with events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted.
# Local testing:  stripe listen --forward-to localhost:3001/api/stripe/webhook
# STRIPE_WEBHOOK_SECRET=
# Optional: a specific Billing Portal configuration (bpc_…); otherwise Stripe's default one is used.
# STRIPE_PORTAL_CONFIGURATION_ID=
# Recurring MONTHLY price ids (price_…); stored on the plans by `npm run db:seed`. Enterprise stays "contact sales".
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PROFESSIONAL=
# STRIPE_PRICE_ENTERPRISE=

# Evolution API v2 (WhatsApp). One global key; each WhatsApp number is an "instance" created from the dashboard.
EVOLUTION_API_URL=http://your-server-ip:8080
EVOLUTION_API_KEY=

# Les clés ci-dessous sont optionnelles : importées une seule fois en base si la DB est vide,
# puis gérées via /settings/ai-voice dans l'interface admin.
# OPENAI_API_KEY=
# APP_PUBLIC_URL=http://localhost:3000
# Green API: prefer /dashboard/settings (stored in DB). Optional one-time .env bootstrap:
# GREEN_API_INSTANCE_ID=
# GREEN_API_TOKEN=
# GREEN_API_URL=https://7107.api.greenapi.com
