# Bootstrap du serveur uniquement (le reste se configure dans le dashboard)
NODE_ENV=development
PORT=3000
# Supabase (Session pooler) or direct connection — URL-encode special chars in password
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Optional for prisma migrate (direct port 5432):
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Les clés ci-dessous sont optionnelles : importées une seule fois en base si la DB est vide,
# puis gérées via /settings/ai-voice dans l'interface admin.
# OPENAI_API_KEY=
# WHATSAPP_PROVIDER=green
# GREEN_API_INSTANCE_ID=
# GREEN_API_TOKEN=
# GREEN_API_URL=https://7107.api.greenapi.com

# EVOLUTION_MOCK=true
# EVOLUTION_MOCK_ON_PROBE_FAILURE=false
# EVOLUTION_BASE_URL=http://your-server:8080
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# EVOLUTION_WEBHOOK_SECRET=
# APP_PUBLIC_URL=http://localhost:3000
