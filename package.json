{
  "name": "whatsapp-ai-qualification-handoff",
  "version": "1.0.0",
  "description": "WhatsApp AI Qualification & Handoff System",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:client": "npm run dev --prefix client",
    "dev:all": "concurrently -n api,web -c blue,green \"npm run dev\" \"npm run dev:client\"",
    "start": "node src/index.js",
    "build": "prisma generate && node src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "admin:grant": "node scripts/set-platform-role.mjs grant",
    "admin:revoke": "node scripts/set-platform-role.mjs revoke",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "esbuild": true
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.1",
    "openai": "^4.73.0",
    "prisma": "^6.0.0",
    "socket.io": "^4.8.1",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
